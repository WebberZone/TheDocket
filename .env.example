APP_NAME=Docket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Single-user SQLite app: the DB_HOST/PORT/etc. block is unused.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="docket@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Docket ---------------------------------------------------------------

# The single owner account (there is no registration flow). The installer
# (php artisan docket:install, or /install in a browser) fills in the
# name/email and creates the account directly, so you normally never edit
# these by hand. They are the fallbacks used if the database is ever
# re-seeded from scratch.
DOCKET_USER_PASSWORD=
# DOCKET_USER_NAME="Docket Owner"
# DOCKET_USER_EMAIL=owner@example.com

# User-Agent sent when fetching saved pages. Some sites block unknown
# agents; override it here if one you read often does.
# DOCKET_USER_AGENT=

# Off-site backup bucket (S3-compatible: Backblaze B2 or Cloudflare R2).
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com
# B2 endpoint looks like https://s3.<region>.backblazeb2.com
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=auto
# Failure alerts go here; falls back to DOCKET_USER_EMAIL when unset.
# BACKUP_NOTIFY_EMAIL=
# Optional: encrypt backup archives with this password (keep a copy in
# your password manager too: no password, no restore). Leave commented
# out to disable encryption; an empty value breaks archive verification.
# BACKUP_ARCHIVE_PASSWORD=
